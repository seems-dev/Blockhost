# Copy to deploy/.env and fill in secrets before: docker compose -f deploy/docker-compose.prod.yml up -d

DOMAIN=yourdomain.com
POSTGRES_PASSWORD=generate-a-strong-password

PRODUCTION_MODE=true
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
WORKER_AGENT_TOKEN=generate-with-openssl-rand-hex-32

CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=false
ALLOW_AUTO_NODE_REGISTRATION=false
BACKGROUND_WORKERS_IN_API=false

MINECRAFT_PUBLIC_HOST=yourdomain.com
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

GOOGLE_CLIENT_ID=

# Paths inside container (mounted volume)
BEDROCK_VERSIONS_DIR=/app/data/versions
BEDROCK_SERVERS_DIR=/app/data/servers
BEDROCK_LOGS_DIR=/app/data/logs
BACKUP_STORAGE_DIR=/app/data/backups
