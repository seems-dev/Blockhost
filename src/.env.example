DATABASE_URL=postgresql+psycopg://blockhost:blockhost@localhost:5432/blockhost
REDIS_URL=redis://localhost:6379/0
PRODUCTION_MODE=false
JWT_SECRET_KEY=change-me-in-prod
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=2592000
MINECRAFT_PUBLIC_HOST=localhost
MINECRAFT_PORT=19132
BEDROCK_RUNTIME_DRIVER=systemd
WORKER_AGENT_TOKEN=change-me-in-dev
RAZORPAY_KEY_ID=change-me-in-prod
RAZORPAY_KEY_SECRET=change-me-in-prod
RAZORPAY_WEBHOOK_SECRET=change-me-in-prod
BILLING_PROVIDER=razorpay

# Phase 3 security
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
ALLOW_AUTO_NODE_REGISTRATION=true

# Production example:
# PRODUCTION_MODE=true
# CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
# ALLOW_AUTO_NODE_REGISTRATION=false

# Agent (worker node)
# NODE_PUBLIC_IP=203.0.113.5
# AGENT_TOKEN=<per-node token from POST /api/nodes/register>

# Phase 4 deployment
# BACKGROUND_WORKERS_IN_API=false   # use separate blockhost-worker process in production
# DOMAIN=yourdomain.com
